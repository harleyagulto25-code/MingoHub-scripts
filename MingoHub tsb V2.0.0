    addSection(main,"Macro")
    addToggle(main,"Backdash Cancel","",Settings.Macros.Backdash.Enabled,function(on) Settings.Macros.Backdash.Enabled=on; setBackdash(on) end,function() return Settings.Macros.Backdash.Enabled end)
    local function addBackdashVar(i5)
        local v2 = Settings.Macros.Backdash.Variants
        local row2b = baseRow(main,32); rowLabels(row2b,"Backdash Cancel "..i5,nil)
        local track4=Instance.new("TextButton"); track4.Size=UDim2.fromOffset(34,18); track4.Position=UDim2.new(1,-112,0.5,-9)
        track4.Text=""; track4.AutoButtonColor=false; track4.BackgroundColor3=v2[i5] and Palette.Accent or Palette.Off
        track4.ZIndex=6; track4:SetAttribute("ThemeRole","toggle"); track4:SetAttribute("ToggleState",v2[i5] and true or false); track4.Parent=row2b; corner(track4,9); stroke(track4,1,0.6)
        local knob4=Instance.new("Frame"); knob4.Size=UDim2.fromOffset(14,14); knob4.Position=v2[i5] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7); knob4.BackgroundColor3=Color3.new(1,1,1); knob4.ZIndex=7; knob4.Parent=track4; corner(knob4,7)
        local function renderV() track4.BackgroundColor3=v2[i5] and Palette.Accent or Palette.Off; track4:SetAttribute("ToggleState",v2[i5] and true or false); knob4.Position=v2[i5] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7) end
        track4.MouseButton1Click:Connect(function() v2[i5]=not v2[i5]; renderV(); if Settings.Macros.Backdash.Enabled then setBackdash(true) end end)
        local kbtn=Instance.new("TextButton"); kbtn.Size=UDim2.fromOffset(72,22); kbtn.Position=UDim2.new(1,-72,0.5,-11)
        kbtn.BackgroundColor3=Palette.Button; kbtn.BackgroundTransparency=0.36; kbtn.TextColor3=Color3.new(1,1,1)
        kbtn.Font=FONT; kbtn.TextSize=11; kbtn.AutoButtonColor=false; kbtn.ZIndex=7; kbtn:SetAttribute("ThemeRole","field"); kbtn.Parent=row2b; corner(kbtn,10); stroke(kbtn,1,0.6)
        local function renderK() local k=Settings.Macros.Backdash.Keys[i5]; kbtn.Text=k and k.Name or "None" end; renderK()
        kbtn.MouseButton1Click:Connect(function()
            if keybindListening then return end; keybindListening=true; currentListenBtn=kbtn; kbtn.Text="Press key..."
            local c2b; c2b=UIS.InputBegan:Connect(function(input,gpe)
                if not gpe and input.UserInputType==Enum.UserInputType.Keyboard then
                    if input.KeyCode~=Enum.KeyCode.Escape then Settings.Macros.Backdash.Keys[i5]=input.KeyCode end
                    renderK(); keybindListening=false; currentListenBtn=nil; c2b:Disconnect()
                    if Settings.Macros.Backdash.Enabled then setBackdash(true) end
                end
            end)
        end)
        registerControl(function() renderV(); renderK() end)
    end
    for i5=1,4 do addBackdashVar(i5) end

