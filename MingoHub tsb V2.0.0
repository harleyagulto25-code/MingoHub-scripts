GB(162,102,29),NeutralColor=Color3.fromRGB(93,144,255),UltColor=Color3.fromRGB(162,147,29),SaitamaUltColor=Color3.fromRGB(250,255,173),DeathCounterColor=Color3.fromRGB(116,35,36),OutlineTransparency=0.7,DeathCounterESP=false,SaitamaUltESP=false,NameUltText=true,Friends={}},CharCopy={Name="",Keep=true},Misc={Notifications={Enabled=true,Ult=true,Counter=true,AutoTech=true,Fling=true},GetPing=false,Stretch={Enabled=false,Value=1},DayTime=nil,ConfigDir="MingoHub_Configs",FriendCheck=false}}local CONFIG_DIR,memoryFiles=Settings.Misc.ConfigDir,{}local function fsReady()return type(writefile)=="function"and type(readfile)=="function"and type(isfile)=="function"end local function ensureConfigDir()if type(makefolder)=="function"and type(isfolder)=="function"then pcall(function()if not isfolder(CONFIG_DIR)then makefolder(CONFIG_DIR)end end)end end local function configPath(name)return CONFIG_DIR.."/"..name..".json"end local function readTextFile(path)if fsReady()then local ok,exists=pcall(isfile,path)if ok and exists then local ok2,data=pcall(readfile,path)if ok2 and type(data)=="string"then return data end end end return memoryFiles[path]end local function writeTextFile(path,data)memoryFiles[path]=data if fsReady()then ensureConfigDir()pcall(writefile,path,data)end end local function sanitizeName(name)name=tostring(name or""):gsub("^%s+",""):gsub("%s+$","")name=name:gsub('[\\/:*?"<>|]',"_")return name~=""and name or nil end local function copyToClipboard(text)if type(setclipboard)=="function"and pcall(setclipboard,text)then return true end if type(toclipboard)=="function"and pcall(toclipboard,text)then return true end return false end local function readClipboard()if type(getclipboard)=="function"then local ok,v=pcall(getclipboard)if ok and type(v)=="string"then return v end end return nil end local function deepCopy(tbl)local out={}for k,v in pairs(tbl)do out[k]=type(v)=="table"and deepCopy(v)or v end return out end local function deepApply(dst,src)for k,v in pairs(src)do local cur=dst[k]if type(cur)=="table"and type(v)=="table"then deepApply(cur,v)elseif cur~=nil and type(v)==type(cur)then dst[k]=v end end end local function listConfigNames()local names,seen={},{}if fsReady()and type(listfiles)=="function"then local ok,files=pcall(listfiles,CONFIG_DIR)if ok and type(files)=="table"then for _,path in ipairs(files)do local fname=tostring(path):match("([^/\\]+)$")if fname and fname:sub(-5)==".json"and fname:sub(1,1)~="_"then local n=fname:sub(1,#fname-5)if not seen[n]then seen[n]=true;names[#names+1]=n end end end end end for path in pairs(memoryFiles)do if path:sub(1,#CONFIG_DIR)==CONFIG_DIR then local fname=path:match("([^/\\]+)$")if fname and fname:sub(-5)==".json"and fname:sub(1,1)~="_"then local n=fname:sub(1,#fname-5)if not seen[n]then seen[n]=true;names[#names+1]=n end end end end table.sort(names)return names end local function readJsonFile(path)local raw=readTextFile(path)if not raw then return nil end local ok,data=pcall(HttpService.JSONDecode,HttpService,raw)if ok and type(data)=="table"then return data end return nil end local AutoLoadState={Enabled=false,Config=""}local function autoLoadPath()return CONFIG_DIR.."/_autoload.json"end local function persistAutoLoad()writeTextFile(autoLoadPath(),HttpService:JSONEncode(AutoLoadState))end local function setAutoLoad(on,name)AutoLoadState.Enabled=on and true or false if name then AutoLoadState.Config=tostring(name)end persistAutoLoad()end do local saved=readJsonFile(autoLoadPath())if saved then AutoLoadState.Enabled=saved.Enabled==true AutoLoadState.Config=tostring(saved.Config or"")end end local function collectConfig()local s=deepCopy(Settings)local bd=s.Backdash and s.Backdash.Keys if bd then for i,k in ipairs(bd)do bd[i]=k and k.Name or nil end end if s.Player and s.Player.FreezeKey then s.Player.FreezeKey=s.Player.FreezeKey.Name end return s end local function applyConfigTable(data)if type(data)~="table"then return false end if type(data.settings)=="table"then for group,values in pairs(Settings)do if type(values)=="table"and type(data.settings[group])=="table"then deepApply(values,data.settings[group])end end local bd=data.settings.Backdash if bd and type(bd.Keys)=="table"then for i,k in ipairs(bd.Keys)do if type(k)=="string"then Settings.Backdash.Keys[i]=Enum.KeyCode[k]end end end if data.settings.Player and type(data.settings.Player.FreezeKey)=="string"then Settings.Player.FreezeKey=Enum.KeyCode[data.settings.Player.FreezeKey]end end return true end local ConfigHooks={applyAppearance=function()end,syncControls=function()end,refreshGameplay=function()end,refreshConfigLists=function()end}local function saveConfig(name)name=sanitizeName(name)if not name then notifySystem("Enter a config name first")return end writeTextFile(configPath(name),HttpService:JSONEncode(collectConfig()))ConfigHooks.refreshConfigLists(name)notifySystem("Saved config: "..name)end local function loadConfig(name)name=sanitizeName(name)if not name then notifySystem("No config selected")return end local data=readJsonFile(configPath(name))if not data then notifySystem("Config not found: "..name)return end if applyConfigTable(data)then ConfigHooks.applyAppearance()ConfigHooks.syncControls()ConfigHooks.refreshGameplay()notifySystem("Loaded config: "..name)end end local function deleteConfig(name)name=sanitizeName(name)if not name then notifySystem("No config selected")return end local path=configPath(name)memoryFiles[path]=nil if fsReady()and type(delfile)=="function"then pcall(function()if isfile(path)then delfile(path)end end)end ConfigHooks.refreshConfigLists()notifySystem("Deleted config: "..name)end local function exportConfig(name)name=sanitizeName(name)local data=name and readJsonFile(configPath(name))or nil if not data then data={settings=collectConfig()}end local json=HttpService:JSONEncode(data)local copied=copyToClipboard(json)print("[MingoHub] Config export:\n"..json)notifySystem(copied and"Config JSON copied"or"Clipboard unavailable, check console")end local function importConfig(name,text)name=sanitizeName(name)or"imported"text=tostring(text or""):gsub("^%s+",""):gsub("%s+$","")if text==""then text=(readClipboard()or""):gsub("^%s+",""):gsub("%s+$","")end if text==""then notifySystem("Paste JSON first")return end local ok,data=pcall(HttpService.JSONDecode,HttpService,text)if not ok or type(data)~="table"then notifySystem("Invalid JSON")return end writeTextFile(configPath(name),HttpService:JSONEncode(data))ConfigHooks.refreshConfigLists(name)notifySystem("Imported: "..name)end local ActiveConnections=setmetatable({},{__mode="k"})local RenderBindings={}local function connectSignal(signal,fn)local conn=signal:Connect(fn)ActiveConnections[conn]=true return conn end local function disconnectAll()for conn in pairs(ActiveConnections)do pcall(function()conn:Disconnect()end)end table.clear(ActiveConnections)for name in pairs(RenderBindings)do pcall(function()RunService:UnbindFromRenderStep(name)end)end table.clear(RenderBindings)end local frontDashCooldown,frontDashLastAt,techRotateActive,blockActive=false,0,false,false local serverNoDash,serverEffect=workspace:GetAttribute("NoDashCooldown"),workspace:GetAttribute("EffectAffects")local spoofingDash=false connectSignal(workspace:GetAttributeChangedSignal("NoDashCooldown"),function()if not spoofingDash then serverNoDash=workspace:GetAttribute("NoDashCooldown")end end)connectSignal(workspace:GetAttributeChangedSignal("EffectAffects"),function()if not spoofingDash then serverEffect=workspace:GetAttribute("EffectAffects")end end)local function spoofDashAttributes(noCooldown)if workspace:GetAttribute("NoDashCooldown")==noCooldown and workspace:GetAttribute("EffectAffects")==(noCooldown and 1 or serverEffect)then return end spoofingDash=true workspace:SetAttribute("NoDashCooldown",noCooldown)workspace:SetAttribute("EffectAffects",noCooldown and 1 or serverEffect)spoofingDash=false end local function hasFreeDash()if Character and Character:FindFirstChild("DashReset3rd")then return true end if not serverNoDash then return false end return serverEffect==1 or workspace:GetAttribute("VIPServerOwner")==player.Name end local function getCommunicate()if Communicate and Communicate.Parent then return Communicate end if Character then Communicate=Character:FindFirstChild("Communicate")or Character:WaitForChild("Communicate",2)end return Communicate end local Mouse pcall(function()Mouse=player:GetMouse()end)local DASH_PRESETS={frontDash={Dash=Enum.KeyCode.W,Key=Enum.KeyCode.Q,Goal="KeyPress"},backDash={Dash=Enum.KeyCode.S,Key=Enum.KeyCode.Q,Goal="KeyPress"},leftDash={Dash=Enum.KeyCode.A,Key=Enum.KeyCode.Q,Goal="KeyPress"},rightDash={Dash=Enum.KeyCode.D,Key=Enum.KeyCode.Q,Goal="KeyPress"},holdBlock={Goal="KeyPress",Key=Enum.KeyCode.F},releaseBlock={Goal="KeyRelease",Key=Enum.KeyCode.F},holdM1={Goal="LeftClick"},releaseM1={Goal="LeftClickRelease"}}local function randomWait(base)task.wait((base or 0)+math.random(2,6)/1000)end local function pressKey(kc)if VirtualInputManager then pcall(function()VirtualInputManager:SendKeyEvent(true,kc,false,game)end)end end local function releaseKey(kc)if VirtualInputManager then pcall(function()VirtualInputManager:SendKeyEvent(false,kc,false,game)end)end end local function tapKey(kc)pressKey(kc);randomWait();releaseKey(kc)end local function setAutoRotate(numberKey)pressKey(numberKey);randomWait(0.01);releaseKey(numberKey)if not sAutoUnequip then randomWait()local vp=Camera.ViewportSize local hx,hy=math.floor(vp.X/2),math.floor(vp.Y/2)if VirtualInputManager then pcall(function()VirtualInputManager:SendMouseButtonEvent(hx,hy,0,true,game,0)end)randomWait()pcall(function()VirtualInputManager:SendMouseButtonEvent(hx,hy,0,false,game,0)end)end end end local function performFrontDash()local comm=getCommunicate()if frontDashCooldown or not comm then return false end if frontDashLastAt>0 and tick()-frontDashLastAt<0.5 and not hasFreeDash()then return false end comm:FireServer(DASH_PRESETS.frontDash)frontDashLastAt=tick()if not hasFreeDash()then frontDashCooldown=true;task.delay(5,function()frontDashCooldown=false end)end return true end local function performDashWithDelay(delay)performFrontDash();task.wait(getPing(1000)+0.05+(delay or 0))end local function fireHoldBlock()local comm=getCommunicate();if not blockActive and comm then blockActive=true;comm:FireServer(DASH_PRESETS.holdBlock)end end local function fireReleaseBlock()local comm=getCommunicate();if blockActive and comm then blockActive=false;comm:FireServer(DASH_PRESETS.releaseBlock)end end local function sendLeftClick()local comm=getCommunicate()if not comm then return end local mobileSpoof=Settings.Player.DeviceSpoof.Enabled and(Settings.Player.DeviceSpoof.Device=="Mobile"or Settings.Player.DeviceSpoof.Device=="Console")randomWait();comm:FireServer({Goal="LeftClick",Mobile=mobileSpoof or nil})randomWait();comm:FireServer({Goal="LeftClickRelease",Mobile=mobileSpoof or nil});randomWait()end local function jumpThenM1()pressKey(Enum.KeyCode.Space);randomWait(0.01);sendLeftClick();releaseKey(Enum.KeyCode.Space)end local function makeRotCFrame(pos,yaw,pitch)Camera.CFrame=CFrame.new(pos)*CFrame.Angles(0,yaw,0)*CFrame.Angles(pitch,0,0)end local function startSmoothRotateCamToPos(targetPos,duration)duration=duration or 0 if duration<=0 then local startCF=Camera.CFrame local dir=(targetPos-startCF.Position)if dir.Magnitude<0.01 then return end dir=dir.Unit makeRotCFrame(startCF.Position,math.atan2(-dir.X,-dir.Z),math.asin(startCF.LookVector.Y))return end local startTick,startCF=tick(),Camera.CFrame local startPos,targetVector=startCF.Position,(targetPos-startCF.Position)if targetVector.Magnitude<0.1 then return end targetVector=targetVector.Unit local startYaw,targetYaw,pitch=math.atan2(-startCF.LookVector.X,-startCF.LookVector.Z),math.atan2(-targetVector.X,-targetVector.Z),math.asin(startCF.LookVector.Y)local name="MingoCam"..tick()RenderBindings[name]=true RunService:BindToRenderStep(name,Enum.RenderPriority.Camera.Value+1,function()local t=math.clamp((tick()-startTick)/duration,0,1)local alpha=t*t*(3-2*t)makeRotCFrame(startPos,startYaw+(targetYaw-startYaw)*alpha,pitch)if t>=1 then RunService:UnbindFromRenderStep(name);RenderBindings[name]=nil end end)end local function computeLockAngles(angle,targetPos,lockChar,rotateCam,precision)if not RootPart or not Humanoid then return end precision=precision or 1 local camCF=Camera.CFrame local camPos=camCF.Position if UIS.MouseBehavior==Enum.MouseBehavior.LockCenter then camPos=camPos-camCF.RightVector*1.75 end local currentYaw,targetYaw if targetPos then local targetVector if lockChar then targetVector=(targetPos-RootPart.Position).Unit;currentYaw=math.atan2(-RootPart.CFrame.LookVector.X,-RootPart.CFrame.LookVector.Z)else targetVector=(targetPos-camPos).Unit;currentYaw=math.atan2(-camCF.LookVector.X,-camCF.LookVector.Z)end targetYaw=math.atan2(-targetVector.X,-targetVector.Z)else local lookV=lockChar and RootPart.CFrame.LookVector or camCF.LookVector currentYaw=math.atan2(-lookV.X,-lookV.Z);targetYaw=currentYaw+math.rad(angle or 0)end local diff=math.atan2(math.sin(targetYaw-currentYaw),math.cos(targetYaw-currentYaw))local finalYaw=currentYaw+diff*precision local doChar,doCam=lockChar or rotateCam,(not lockChar)or rotateCam if doChar then Humanoid.AutoRotate=false pcall(function()RootPart.CFrame=CFrame.new(RootPart.Position)*CFrame.Angles(0,finalYaw,0)end)if not doCam then return end end makeRotCFrame(camCF.Position,finalYaw,math.asin(camCF.LookVector.Y))end local function startSmoothRotateCamera(angle,duration,rotateChar)if not RootPart or not Humanoid then return end duration=math.max(duration or 0.001,0.001)local startTick=tick()local startCF=rotateChar and RootPart.CFrame or Camera.CFrame local startYaw=math.atan2(-startCF.LookVector.X,-startCF.LookVector.Z)local targetYaw=startYaw+math.rad(angle)local name="MingoCamAng"..tick()RenderBindings[name]=true RunService:BindToRenderStep(name,Enum.RenderPriority.Camera.Value+1,function()local t=math.clamp((tick()-startTick)/duration,0,1)local alpha=t*t*(3-2*t)local camCF=Camera.CFrame local finalYaw=startYaw+(targetYaw-startYaw)*alpha if rotateChar then Humanoid.AutoRotate=false pcall(function()RootPart.CFrame=CFrame.new(RootPart.Position)*CFrame.Angles(0,finalYaw,0)end)else makeRotCFrame(camCF.Position,finalYaw,math.asin(camCF.LookVector.Y))end if t>=1 then RunService:UnbindFromRenderStep(name);RenderBindings[name]=nil end end)end local function isAnimPlaying(animId,hum)hum=hum or Humanoid if not hum then return false end local animator=hum:FindFirstChildOfClass("Animator")or hum:FindFirstChild("Animator")if not animator then return false end local idStr=tostring(animId)for _,track in ipairs(animator:GetPlayingAnimationTracks())do local a=track.Animation if a and a.AnimationId and string.find(a.AnimationId,idStr,1,true)then return true end end return false end local function stopAnimById(animId)if not Animator then return end for _,track in ipairs(Animator:GetPlayingAnimationTracks())do local a=track.Animation if a and a.AnimationId=="rbxassetid://"..tostring(animId)then track:Stop()end end end local function isFlingTargetValid(char,ignoreSet)if not char then return false end for _,child in pairs(char:GetChildren())do if ignoreSet[child.Name]then return false end end return true end local function angleBetweenCFrames(part)if not RootPart or not part then return 0 end local look=Vector3.new(RootPart.CFrame.LookVector.X,0,RootPart.CFrame.LookVector.Z).Unit local vec=part.Position-RootPart.Position vec=Vector3.new(vec.X,0,vec.Z)if vec.Magnitude==0 then return 0 end return math.deg(math.acos(math.clamp(look:Dot(vec.Unit),-1,1)))end local function isWithinFieldOfView(part,fov)return angleBetweenCFrames(part)<=((fov or 360)/2)end local function dashVelocityGuard(part)if not RootPart then return false end local vel=part.AssemblyLinearVelocity if vel.Magnitude<0.1 then return false end local toMe=RootPart.Position-part.Position if toMe.Magnitude<0.01 then return false end return vel.Unit:Dot(toMe.Unit)>0.7 end local function isTargetAbove(targetHRP)if not RootPart then return false end local myPos,targetPos=RootPart.Position,targetHRP.Position local hDist=(Vector3.new(myPos.X,0,myPos.Z)-Vector3.new(targetPos.X,0,targetPos.Z)).Magnitude return hDist<=0.2 and myPos.Y<targetPos.Y end local function characterRotateEasing(part,hum,duration)duration=duration or 0 local conn conn=RunService.Heartbeat:Connect(function(dt)if not part.Parent or not RootPart or not RootPart.Parent or hum.Health<=0 or(Humanoid and Humanoid.Health<=0)then conn:Disconnect();return end if isFlingTargetValid(Character,localBusySet)then Humanoid.AutoRotate=false local cf=RootPart.CFrame local targetCF=CFrame.new(cf.Position,Vector3.new(part.Position.X,cf.Position.Y,part.Position.Z))pcall(function()if duration<=0 then RootPart.CFrame=targetCF else RootPart.CFrame=cf:Lerp(targetCF,math.clamp(dt/duration,0,1))end end)end end)ActiveConnections[conn]=true return conn end local function stopRotateConn(conn)if conn then pcall(function()conn:Disconnect()end)ActiveConnections[conn]=nil if Humanoid then Humanoid.AutoRotate=true end end end local function autoblockEasingTick(part,hum)local conn if Settings.Autoblock.RotateChar then conn=characterRotateEasing(part,hum,Settings.Autoblock.CharEasing)end if Settings.Autoblock.RotateCam then startSmoothRotateCamToPos(part.Position,Settings.Autoblock.CamEasing)end return conn end local function detectDevice()local ok,tenFoot=pcall(function()return game:GetService("GuiService"):IsTenFootInterface()end)if ok and tenFoot then return"Console",false end local cam=workspace.CurrentCamera local small=cam and cam.ViewportSize.X<900 and UIS.TouchEnabled if(UIS.TouchEnabled and not UIS.KeyboardEnabled)or small then return"Mobile",true end return"PC",false end local DEVICE DEVICE,isMobile=detectDevice()local function getExecutorName()if identifyexecutor then local ok,name=pcall(identifyexecutor);if ok and name then return tostring(name)end end if getexec