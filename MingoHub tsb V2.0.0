    addSlider(exploit,"Offset","20-80 (x0.1 studs)",20,80,math.floor(Settings.Rage.SideDashAssist.Offset*10+0.5),function(v) Settings.Rage.SideDashAssist.Offset=v/10 end,function() return math.floor(Settings.Rage.SideDashAssist.Offset*10+0.5) end)
    addSlider(exploit,"Curve Strength","10-100 %",10,100,math.floor(Settings.Rage.SideDashAssist.Strength*100+0.5),function(v) Settings.Rage.SideDashAssist.Strength=v/100 end,function() return math.floor(Settings.Rage.SideDashAssist.Strength*100+0.5) end)

    addSection(exploit,"Magnet")
    addToggle(exploit,"Auto Magnet","Teleport above + pull to target",Settings.Misc.Magnet.Enabled,function(on) Settings.Misc.Magnet.Enabled=on; if not on then MagnetState.stop() end end,function() return Settings.Misc.Magnet.Enabled end)
    addKeybind(exploit,"Magnet Keybind","",nil,function() MagnetState.execute() end,nil,nil)
    addDropdown(exploit,"Tech Trigger","Auto magnet after tech",{"Disabled","Loop Dash v2","Custom Dash","Custom Dash v2","All 3"},Settings.Misc.Magnet.TechTrigger,function(v) Settings.Misc.Magnet.TechTrigger=v end,function() return Settings.Misc.Magnet.TechTrigger end)
    addSlider(exploit,"Tech Delay","0-500 ms",0,500,Settings.Misc.Magnet.TechDelay,function(v) Settings.Misc.Magnet.TechDelay=v end,function() return Settings.Misc.Magnet.TechDelay end)
    addSlider(exploit,"Pull Duration","100-2000 ms",100,2000,math.floor(Settings.Misc.Magnet.Duration*1000+0.5),function(v) Settings.Misc.Magnet.Duration=v/1000 end,function() return math.floor(Settings.Misc.Magnet.Duration*1000+0.5) end)
    addSlider(exploit,"TP Height","0-15 studs",0,15,Settings.Misc.Magnet.Height,function(v) Settings.Misc.Magnet.Height=v end,function() return Settings.Misc.Magnet.Height end)
    addSlider(exploit,"Pull Strength","10-150",10,150,Settings.Misc.Magnet.Strength,function(v) Settings.Misc.Magnet.Strength=v end,function() return Settings.Misc.Magnet.Strength end)
    addSlider(exploit,"Max Distance","10-300 studs",10,300,Settings.Misc.Magnet.MaxDistance,function(v) Settings.Misc.Magnet.MaxDistance=v end,function() return Settings.Misc.Magnet.MaxDistance end)
    addToggle(exploit,"Dash Cancel","Cancel velocity on activate",Settings.Misc.Magnet.DashCancel,function(on) Settings.Misc.Magnet.DashCancel=on end,function() return Settings.Misc.Magnet.DashCancel end)

    -- ───────── MISC TAB ─────────
    addSection(miscTab,"Notifications")
    addToggle(miscTab,"Enabled","Show MingoHub notifications",Settings.Misc.Notifications.Enabled,function(on) Settings.Misc.Notifications.Enabled=on end,function() return Settings.Misc.Notifications.Enabled end)
    addToggle(miscTab,"Ultimates","Notify on enemy ult",Settings.Misc.Notifications.Ult,function(on) Settings.Misc.Notifications.Ult=on end,function() return Settings.Misc.Notifications.Ult end)
    addToggle(miscTab,"Death Counters","Notify on death counter",Settings.Misc.Notifications.Counter,function(on) Settings.Misc.Notifications.Counter=on end,function() return Settings.Misc.Notifications.Counter end)
    addToggle(miscTab,"Auto Tech Events","Notify on auto tech",Settings.Misc.Notifications.AutoTech,function(on) Settings.Misc.Notifications.AutoTech=on end,function() return Settings.Misc.Notifications.AutoTech end)

    addSection(miscTab,"Tech Helper")
    addToggle(miscTab,"Enabled","",Settings.Macros.TechHelper.Enabled,function(on) Settings.Macros.TechHelper.Enabled=on end,function() return Settings.Macros.TechHelper.Enabled end)
    addDropdown(miscTab,"Variant","",{"Humbled Twisted","Loop Dash","Instant Lee","Oreo Tech","Lix Tech"},Settings.Macros.TechHelper.Tech,function(v) Settings.Macros.TechHelper.Tech=v end,function() return Settings.Macros.TechHelper.Tech end)
    addKeybind(miscTab,"Tech Helper Key","Press on 3rd M1",nil,function() task.spawn(runTechHelper) end,nil,nil)
    addToggle(miscTab,"Extra Tech Enabled","",Settings.Macros.ExtraTechHelper.Enabled,function(on) Settings.Macros.ExtraTechHelper.Enabled=on end,function() return Settings.Macros.ExtraTechHelper.Enabled end)
    addDropdown(miscTab,"Extra Variant","",{"Instant Lethal Shift Lock","Instant Lethal Loop Dash"},Settings.Macros.ExtraTechHelper.Tech,function(v) Settings.Macros.ExtraTechHelper.Tech=v end,function() return Settings.Macros.ExtraTechHelper.Tech end)
    addKeybind(miscTab,"Extra Tech Key","",nil,function() task.spawn(runExtraTechHelper) end,nil,nil)

    addSection(miscTab,"Emote Dash")
    addToggle(miscTab,"Enabled","",Settings.Macros.EmoteDash.Enabled,function(on) Settings.Macros.EmoteDash.Enabled=on end,function() return Settings.Macros.EmoteDash.Enabled end)
    addKeybind(miscTab,"Emote Dash Key","",nil,function() task.spawn(runEmoteDash) end,nil,nil)
    addTextbox(miscTab,"Delay (s)","",Settings.Macros.EmoteDash.Delay,function(v) Settings.Macros.EmoteDash.Delay=math.clamp(tonumber(v) or 0.05,0,1) end,true,function() return Settings.Macros.EmoteDash.Delay end)
    addDropdown(miscTab,"Type","",{"Right","Left","Straight"},Settings.Macros.EmoteDash.Type,function(v) Settings.Macros.EmoteDash.Type=v end,function() return Settings.Macros.EmoteDash.Type end)

    addSection(miscTab,"True M1 Reset")
    addToggle(miscTab,"Enabled","",Settings.Macros.TrueM1Reset.Enabled,function(on) Settings.Macros.TrueM1Reset.Enabled=on end,function() return Settings.Macros.TrueM1Reset.Enabled end)
    addKeybind(miscTab,"M1 Reset Key","Press on 2nd M1",nil,function() task.spawn(runTrueM1Reset) end,nil,nil)

    addSection(miscTab,"Friend Check")
    addToggle(miscTab,"Respect Friends","Skip friends in autoblock/tech",Settings.Misc.FriendCheck,function(on) Settings.Misc.FriendCheck=on end,function() return Settings.Misc.FriendCheck end)

    addSection(miscTab,"Custom Background")
    addToggle(miscTab,"Enabled","Override background image",Settings.Visuals.CustomBackground.Enabled,function(on) Settings.Visuals.CustomBackground.Enabled=on; applyBackground(Appearance.Background) end,function() return Settings.Visuals.CustomBackground.Enabled end)
    addTextbox(miscTab,"Image Asset ID","Asset ID of the image",Settings.Visuals.CustomBackground.ImageId,function(v) Settings.Visuals.CustomBackground.ImageId=v; if Settings.Visuals.CustomBackground.Enabled then applyBackground(Appearance.Background) end end,false,function() return Settings.Visuals.CustomBackground.ImageId end)
    addButton(miscTab,"Apply","Apply custom background",function() applyBackground(Appearance.Background) end,"Apply")
    addButton(miscTab,"Reset","Revert to default",function() Settings.Visuals.CustomBackground.Enabled=false; Settings.Visuals.CustomBackground.ImageId=""; applyBackground(Appearance.Background) end,"Reset")

    addSection(miscTab,"Custom Ultbar")
    addToggle(miscTab,"Custom Ultbar Text","",Settings.Visuals.CustomUltbar.UltbarText.Enabled,function(on) Settings.Visuals.CustomUltbar.UltbarText.Enabled=on; task.spawn(setupUltbar) end,function() return Settings.Visuals.CustomUltbar.UltbarText.Enabled end)
    addTextbox(miscTab,"Ultbar Text","",Settings.Visuals.CustomUltbar.UltbarText.Text,function(v) Settings.Visuals.CustomUltbar.UltbarText.Text=v; task.spawn(setupUltbar) end,false,function() return Settings.Visuals.CustomUltbar.UltbarText.Text end)
    addToggle(miscTab,"Custom Ultbar Color","",Settings.Visuals.CustomUltbar.UltbarColor.Enabled,function(on) Settings.Visuals.CustomUltbar.UltbarColor.Enabled=on; task.spawn(setupUltbar) end,function() return Settings.Visuals.CustomUltbar.UltbarColor.Enabled end)
    addColorRow(miscTab,"Ultbar Color","",function() return Settings.Visuals.CustomUltbar.UltbarColor.Color end,function(c) Settings.Visuals.CustomUltbar.UltbarColor.Color=c; task.spawn(setupUltbar) end)

    addSection(miscTab,"Configuration")
    local nameBox = addTextbox(miscTab,"Config Name","Name for save / import","default")
    addButton(miscTab,"Save Config","Save current settings",function() saveConfig(nameBox.Text) end,"Save")
    local selector2 = makeConfigSelector(miscTab,"Config List","Pick the active config")
    addButton(miscTab,"Load Config","Apply selected config",function() loadConfig(selector2.get()) end,"Load")
    addButton(miscTab,"Delete Config","Delete selected config",function() deleteConfig(selector2.get()) end,"Delete")
    addButton(miscTab,"Export Config","Copy JSON to clipboard",function() exportConfig(selector2.get() or nameBox.Text) end,"Export")
    local importBox = addTextbox(miscTab,"Import JSON","Paste JSON or copy to clipboard","")
    addButton(miscTab,"Import Config","Save JSON as config",function() importConfig(nameBox.Text, importBox.Text) end,"Import")
    addToggle(miscTab,"Auto Load","Load selected config on start",AutoLoadState.Enabled,function(on) setAutoLoad(on, selector2.get()) end,function() return AutoLoadState.Enabled end)

    -- ───────── SETTING TAB ─────────
    do
        local names2 = {}
        for _, b in ipairs(BACKGROUNDS) do if b.image ~= "" then names2[#names2+1]=b.name end end
        addSection(setting,"Appearance")
        addDropdown(setting,"Background","Tap to switch",names2,Appearance.Background,function(v) applyBackground(v) end,function() return Appearance.Background end)
        addToggle(setting,"Blur Effect","Blur game behind UI",Appearance.Blur,function(on) setBlur(on) end,function() return Appearance.Blur end)
        addToggle(setting,"Edge Glow","Pulsing accent glow around window",Appearance.EdgeGlow,function(on) setEdgeGlow(on) end,function() return Appearance.EdgeGlow end)
        addDropdown(setting,"UI Size","75% - 200%",SCALE_OPTIONS,scaleLabel(Appearance.Scale),function(v) setUiScale(SCALE_VALUES[v] or 1) end,function() return scaleLabel(Appearance.Scale) end)
        addColorRow(setting,"Accent Color","",function() return Palette.Accent end,function(c) applyColors(c,Palette.Button,Palette.Border) end)
        addColorRow(setting,"Button Color","",function() return Palette.Button end,function(c) applyColors(Palette.Accent,c,Palette.Border) end)
        addColorRow(setting,"Border Color","",function() return Palette.Border end,function(c) applyColors(Palette.Accent,Palette.Button,c) end)
    end

    -- ───────── Window open/close ─────────
    local visibilityButton
    local function setOpen(open)
        isOpen = open
        if open then
            root.Visible = true
            rootScale.Scale = 0.93; window.GroupTransparency = 0.35
            pcall(tween, rootScale, 0.32, {Scale=1}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            pcall(tween, window,    0.28, {GroupTransparency=0}, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            pcall(function() tween(ensureBlur(), 0.6, {Size=Appearance.Blur and BLUR_SIZE or 0}) end)
        else
            pcall(tween, rootScale, 0.18, {Scale=0.94}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
            local fadeOk = pcall(function()
                local fo = tween(window, 0.19, {GroupTransparency=1}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
                fo.Completed:Connect(function(ps)
                    if not isOpen and ps==Enum.PlaybackState.Completed then root.Visible=false; rootScale.Scale=1 end
                end)
            end)
            if not fadeOk then window.GroupTransparency=1; root.Visible=false; rootScale.Scale=1 end
            pcall(function() tween(ensureBlur(), 0.3, {Size=0}) end)
        end
        if visibilityButton then visibilityButton.Text = open and "HIDE UI" or "SHOW UI" end
    end

    local function forceShow()
        if not gui.Parent then pcall(function() gui.Parent=getGuiParent() end) end
        gui.Enabled=true; gui.DisplayOrder=2147483647
        if not isOpen then return end
        root.Visible=true; rootScale.Scale=1
        if window.GroupTransparency>0.5 then window.GroupTransparency=0 end
    end

    closeDot.Activated:Connect(function() setOpen(false) end)
    minDot.MouseButton1Click:Connect(function()
        minimized=not minimized; local h=minimized and BAR_H or WIN_H
        tween(window,0.5,{Size=UDim2.fromOffset(WIN_W,h)},Enum.EasingStyle.Quint)
        tween(glowHalo,0.5,{Size=UDim2.fromOffset(WIN_W,h)},Enum.EasingStyle.Quint)
        tween(glowEdge,0.5,{Size=UDim2.fromOffset(WIN_W,h)},Enum.EasingStyle.Quint)
    end)
    maxDot.MouseButton1Click:Connect(function()
        minimized=false
        tween(window,0.5,{Size=UDim2.fromOffset(WIN_W,WIN_H)},Enum.EasingStyle.Quint)
        tween(glowHalo,0.5,{Size=UDim2.fromOffset(WIN_W,WIN_H)},Enum.EasingStyle.Quint)
        tween(glowEdge,0.5,{Size=UDim2.fromOffset(WIN_W,WIN_H)},Enum.EasingStyle.Quint)
    end)

    local lastToggle = 0
    local function toggleUI()
        if os.clock()-lastToggle<0.25 then return end; lastToggle=os.clock(); setOpen(not isOpen)
    end
    UIS.InputBegan:Connect(function(input,processed)
        if input.KeyCode==Enum.KeyCode.RightShift and not UIS:GetFocusedTextBox() then toggleUI() end
    end)
    pcall(function()
        CAS:BindActionAtPriority("MingoHubToggleUI", function(_, state)
            if state==Enum.UserInputState.Begin then toggleUI(); return Enum.ContextActionResult.Sink end
            return Enum.ContextActionResult.Pass
        end, false, 3000, Enum.KeyCode.RightShift)
    end)

    -- Floating dock (mobile)
    local dock = Instance.new("Frame"); dock.Name = "FloatingVisibilityDock"
    dock.Size = UDim2.fromOffset(158,46); dock.Position = UDim2.new(0,24,0.5,58)
    dock.BackgroundColor3 = Color3.fromRGB(13,15,22); dock.BackgroundTransparency = 0.10
    dock.BorderSizePixel = 0; dock.Active = true; dock.Visible = false; dock.ZIndex = 30; dock.Parent = gui
    corner(dock,23); stroke(dock,1.5,0.05)

    visibilityButton = Instance.new("TextButton"); visibilityButton.Name = "ShowHideButton"
    visibilityButton.Size = UDim2.fromOffset(76,32); visibilityButton.Position = UDim2.fromOffset(7,7)
    visibilityButton.BackgroundColor3 = Palette.Button; visibilityButton.BackgroundTransparency = 0.04
    visibilityButton.BorderSizePixel = 0; visibilityButton.Text = "SHOW UI"; visibilityButton.TextColor3 = Color3.new(1,1,1)
    visibilityButton.Font = FONT_BOLD; visibilityButton.TextSize = 11; visibilityButton.AutoButtonColor = false
    visibilityButton.ZIndex = 31; visibilityButton:SetAttribute("ThemeRole","button"); visibilityButton.Parent = dock
    corner(visibilityButton,16); stroke(visibilityButton,1,0.08)

    local lockButton = Instance.new("TextButton"); lockButton.Name = "DockLockButton"
    lockButton.Size = UDim2.fromOffset(65,32); lockButton.Position = UDim2.fromOffset(86,7)
    lockButton.BackgroundColor3 = Color3.fromRGB(35,39,52); lockButton.BackgroundTransparency = 0.02
    lockButton.BorderSizePixel = 0; lockButton.Text = "LOCKED"; lockButton.TextColor3 = Color3.fromRGB(232,235,255)
    lockButton.Font = FONT_BOLD; lockButton.TextSize = 9; lockButton.AutoButtonColor = false
    lockButton.ZIndex = 31; lockButton.Parent = dock; corner(lockButton,16); stroke(lockButton,1,0.08)

    local dockLocked=true; local dockDrag=false; local dockDragStart3; local dockStartPos; local suppressDock=false
    local function beginDockDrag(input)
        if dockLocked then return end
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dockDrag=true; suppressDock=false; dockDragStart3=input.Position; dockStartPos=dock.Position
        end
    end
    visibilityButton.InputBegan:Connect(beginDockDrag); lockButton.InputBegan:Connect(beginDockDrag)
    UIS.InputChanged:Connect(function(input)
        if dockDrag and not dockLocked and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local d=input.Position-dockDragStart3
            if math.abs(d.X)>5 or math.abs(d.Y)>5 then suppressDock=true end
            dock.Position=UDim2.new(dockStartPos.X.Scale,dockStartPos.X.Offset+d.X,dockStartPos.Y.Scale,dockStartPos.Y.Offset+d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dockDrag=false end
    end)
    lockButton.Activated:Connect(function()
        if suppressDock then suppressDock=false; return end
        dockLocked=not dockLocked; lockButton.Text=dockLocked and "LOCKED" or "UNLOCKED"
        lockButton.BackgroundColor3=dockLocked and Color3.fromRGB(35,39,52) or Palette.Button
        tween(lockButton,0.18,{BackgroundTransparency=dockLocked and 0.02 or 0},Enum.EasingStyle.Sine,Enum.EasingDirection.Out)
    end)
    visibilityButton.Activated:Connect(function()
        if suppressDock then suppressDock=false; return end
        setOpen(not isOpen); visibilityButton.Text=isOpen and "HIDE UI" or "SHOW UI"
    end)

    -- Intro animation
    local function playIntro()
        introActive = true
        local introGui2, refs2
        local ok30, err5 = pcall(function()
            local introParent = getGuiParent()
            local ex = introParent:FindFirstChild("MingoHubIntro"); if ex then ex:Destroy() end
            introGui2 = Instance.new("ScreenGui"); introGui2.Name = "MingoHubIntro"
            introGui2.ResetOnSpawn=false; introGui2.IgnoreGuiInset=true; introGui2.DisplayOrder=2147483647
            introGui2.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; introGui2.Parent=introParent
            ensureBlur().Size=0
            local backdrop2 = Instance.new("CanvasGroup"); backdrop2.Size=UDim2.fromScale(1,1)
            backdrop2.BackgroundColor3=Color3.fromRGB(4,6,16); backdrop2.BackgroundTransparency=0.3
            backdrop2.BorderSizePixel=0; backdrop2.GroupTransparency=1; backdrop2.Parent=introGui2
            local holder2 = Instance.new("Frame"); holder2.Size=UDim2.new(1,-40,0,220); holder2.Position=UDim2.fromScale(0.5,0.5)
            holder2.AnchorPoint=Vector2.new(0.5,0.5); holder2.BackgroundTransparency=1; holder2.Parent=backdrop2
            local holderScale2 = Instance.new("UIScale"); holderScale2.Scale=0.72; holderScale2.Parent=holder2
            local title2 = Instance.new("TextLabel"); title2.Size=UDim2.fromScale(1,0.62)
            title2.BackgroundTransparency=1; title2.Text="MingoHub"; title2.TextScaled=true
            title2.Font=Enum.Font.GothamBlack; title2.TextColor3=Color3.new(1,1,1); title2.TextTransparency=1; title2.Parent=holder2
            local titleGrad2 = Instance.new("UIGradient")
            titleGrad2.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Palette.Accent),ColorSequenceKeypoint.new(0.5,Color3.new(1,1,1)),ColorSequenceKeypoint.new(1,Palette.AccentLight)})
            titleGrad2.Offset=Vector2.new(-1,0); titleGrad2.Parent=title2
            local titleGlow2 = Instance.new("UIStroke"); titleGlow2.Color=Palette.Accent; titleGlow2.Thickness=2; titleGlow2.Transparency=1; titleGlow2.ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual; titleGlow2.Parent=title2
            local subtitle2 = Instance.new("TextLabel"); subtitle2.Size=UDim2.new(1,0,0.28,0); subtitle2.Position=UDim2.new(0,0,0.67,0)
            subtitle2.BackgroundTransparency=1; subtitle2.Text="- By Mingo the mango"; subtitle2.TextScaled=true
            subtitle2.Font=Enum.Font.GothamMedium; subtitle2.TextColor3=Color3.fromRGB(205,214,255); subtitle2.TextTransparency=1; subtitle2.Parent=holder2
            local line2 = Instance.new("Frame"); line2.Size=UDim2.fromOffset(0,2); line2.Position=UDim2.new(0.5,0,0.63,0)
            line2.AnchorPoint=Vector2.new(0.5,0.5); line2.BackgroundColor3=Palette.Accent; line2.BackgroundTransparency=1; line2.BorderSizePixel=0; line2.Parent=holder2
            refs2 = {backdrop=backdrop2,holderScale=holderScale2,title=title2,titleGlow=titleGlow2,titleGradient=titleGrad2,subtitle=subtitle2,line=line2}
        end)
        if ok30 and refs2 then
            pcall(function()
                tween(refs2.backdrop,0.5,{GroupTransparency=0},Enum.EasingStyle.Sine,Enum.EasingDirection.Out)
                tween(ensureBlur(),1.0,{Size=26},Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
                tween(refs2.holderScale,1.0,{Scale=1},Enum.EasingStyle.Back,Enum.EasingDirection.Out)
                tween(refs2.title,0.45,{TextTransparency=0},Enum.EasingStyle.Sine,Enum.EasingDirection.Out)
                tween(refs2.titleGlow,1.2,{Transparency=0.1},Enum.EasingStyle.Sine,Enum.EasingDirection.Out)
                tween(refs2.titleGradient,2.4,{Offset=Vector2.new(1,0)},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
                tween(refs2.line,0.7,{Size=UDim2.fromOffset(220,2),BackgroundTransparency=0.15},Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
                task.delay(0.35,function() if refs2.subtitle.Parent then tween(refs2.subtitle,0.6,{TextTransparency=0},Enum.EasingStyle.Sine,Enum.EasingDirection.Out) end end)
            end)
            task.wait(2.0)
            pcall(function()
                setOpen(true)
                tween(refs2.backdrop,0.55,{GroupTransparency=1},Enum.EasingStyle.Sine,Enum.EasingDirection.In)
                tween(ensureBlur(),0.8,{Size=Appearance.Blur and BLUR_SIZE or 0},Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
            end)
            task.wait(0.6)
        else
            warn("[MingoHub] Intro skipped: " .. tostring(err5))
        end
        introActive = false
        if introGui2 and introGui2.Parent then introGui2:Destroy() end
        pcall(setOpen, true)
        pcall(function() ensureBlur().Size=Appearance.Blur and BLUR_SIZE or 0 end)
    end

    return {
        autoLoadOnStart = autoLoadOnStart,
        applyBackground = applyBackground,
        applyTheme      = applyTheme,
        selectTab       = selectTab,
        playIntro       = playIntro,
        setOpen         = setOpen,
        forceShow       = forceShow,
        isOpen          = function() return isOpen end,
        dock            = dock,
        notify          = notify,
    }
end

-- ─────────────────────────── Error reporting ─────────────────────
local function reportBuildError(err6)
    local msg = tostring(err6); warn("[MingoHub] UI build failed: " .. msg)
    task.spawn(function()
        pcall(function()
            StarterGui:SetCore("SendNotification", {Title="MingoHub", Text="UI error: "..msg:sub(1,120), Duration=10})
        end)
    end)
end

-- ─────────────────────────── Boot ─────────────────────────────────
local buildOk, Hub = pcall(buildUI)
if not buildOk then reportBuildError(Hub); return end

print("[MingoHub] UI built — applying startup state")
notifySystem(VERSION .. " — UI built", 2)

local function runStage(label, fn)
    local ok31, err7 = pcall(fn)
    if not ok31 then warn("[MingoHub] " .. label .. " failed: " .. tostring(err7)) end
end

runStage("auto-load",   function() Hub.autoLoadOnStart() end)
runStage("background",  function() Hub.applyBackground(Appearance.Background) end)
runStage("theme",       function() Hub.applyTheme() end)
runStage("tabs",        function() Hub.selectTab("Main", true) end)
runStage("dock",        function() Hub.dock.Visible = isMobile end)
runStage("show",        function() if not Hub.isOpen() then Hub.setOpen(true) end; Hub.forceShow() end)
runStage("intro",       function() task.spawn(function() pcall(Hub.playIntro) end) end)

task.delay(3.5, function() pcall(Hub.forceShow) end)
task.delay(9,   function() pcall(Hub.forceShow) end)

notifySystem(isMobile and (VERSION .. " — tap SHOW UI") or (VERSION .. " — RightShift to toggle"), 5)
print("[MingoHub] Loaded OK — " .. VERSION)
