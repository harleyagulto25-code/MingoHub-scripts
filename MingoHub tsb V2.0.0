-- ─────────────────────────── Ping ───────────────────────────────
local DataPing
pcall(function() DataPing = Stats.Network.ServerStatsItem["Data Ping"] end)

local pingState = { value = 0 }
task.spawn(function()
    while true do
        local ok, v = pcall(DataPing.GetValue, DataPing)
        if ok then pingState.value = v end
        task.wait(0.25)
    end
end)
local function getPing(div) return pingState.value / (div or 1) end
local function pingCompRange(range) return range + (getPing() - 50) * -0.0003846 end
local function pingRangePair(r)
    local lo = r + (getPing() - 50) * -0
    return { lo, r - lo }
end

