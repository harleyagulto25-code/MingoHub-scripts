d AB.blockActive=true;AB.blockUntil=tick()+duration local thisSession={};AB.blockSession=thisSession fireHoldBlock()local rotConn if Settings.Autoblock.RotateChar and targetRoot and targetHum then rotConn=autoblockEasingTick(targetRoot,targetHum)end if Settings.Autoblock.RotateCam and targetRoot then startSmoothRotateCamToPos(targetRoot.Position,Settings.Autoblock.CamEasing)end task.spawn(function()while tick()<AB.blockUntil and AB.blockSession==thisSession do task.wait()end if rotConn then stopRotateConn(rotConn)end if AB.blockSession==thisSession then AB.blockActive=false;AB.blockSession=nil;fireReleaseBlock()end end)return true end local function m1Punish(targetRoot,targetHum)if tick()-AB.lastPunish<0.25 then return end AB.lastPunish=tick()if not targetRoot.Parent or not isFlingTargetValid(targetRoot.Parent,counterLikeSet)then return end if Character and Character:FindFirstChild("CanBringUp")then return end local rotConn if Settings.Autoblock.RotateChar and targetRoot then rotConn=characterRotateEasing(targetRoot,targetHum,Settings.Autoblock.CharEasing)end if Settings.Autoblock.RotateCam and targetRoot then startSmoothRotateCamToPos(targetRoot.Position,Settings.Autoblock.CamEasing)end sendLeftClick();task.wait(0.1)if rotConn then stopRotateConn(rotConn)end end local function autoblockDistanceState(targetRoot,targetHum,dashPredicted)if Character and Character:FindFirstChild("Counter")then return end local blockTime=waitRange(Settings.Autoblock.BlockHold or 0.25)[1]beginBlockHold(blockTime,targetRoot,targetHum)local dist=(RootPart.Position-targetRoot.Position).Magnitude local isClose=dist<=(Settings.Autoblock.Range or 9)local isMoving=dist<=Distances.MovingM1 and dashVelocityGuard(targetRoot)if Settings.Autoblock.AutoM1 and(isClose or isMoving or dashPredicted)then if targetRoot.Parent and isFlingTargetValid(targetRoot.Parent,counterLikeSet)and not(Character and Character:FindFirstChild("CanBringUp"))then local rotConn=autoblockEasingTick(targetRoot,targetHum)sendLeftClick();task.wait(0.1)if rotConn then stopRotateConn(rotConn)end end end end local function autoblockBarrageLoop(targetRoot,targetHum,targetChar,dashPredicted)if AB.barrageActive then return end AB.barrageActive=true local rotConn=autoblockEasingTick(targetRoot,targetHum)local startAt=tick()local heartConn heartConn=RunService.Heartbeat:Connect(function()if not RootPart or not RootPart.Parent or not targetRoot.Parent then if rotConn then stopRotateConn(rotConn)end AB.barrageActive=false;fireReleaseBlock()heartConn:Disconnect();ActiveConnections[heartConn]=nil return end fireHoldBlock()local elapsed=tick()-startAt local alpha=math.clamp(elapsed/0.1,0,1)local dist=(RootPart.Position-targetRoot.Position).Magnitude if targetChar:FindFirstChild("NoBlock")or dist>=(Distances.Barrage+5)then if rotConn then stopRotateConn(rotConn)end AB.barrageActive=false;fireReleaseBlock()heartConn:Disconnect();ActiveConnections[heartConn]=nil if Settings.Autoblock.AutoM1 and dist<=(Settings.Autoblock.Range or 9)then m1Punish(targetRoot,targetHum)end return end if alpha>=1 and not targetChar:FindFirstChild("Slowed")then if rotConn then stopRotateConn(rotConn)end AB.barrageActive=false;fireReleaseBlock()heartConn:Disconnect();ActiveConnections[heartConn]=nil end end)ActiveConnections[heartConn]=true end local function autoblockReact(targetChar,eventName)if not Settings.Autoblock.Enabled or targetChar==Character then return end if isrbxactive and not isrbxactive()then return end if not RootPart or not Humanoid or Humanoid.Health<=0 then return end local targetHRP=targetChar:FindFirstChild("HumanoidRootPart")local targetHum=targetChar:FindFirstChildOfClass("Humanoid")if not targetHRP or not targetHum or targetHum.Health<=0 then return end local plr=Players:GetPlayerFromCharacter(targetChar)if plr==player then return end if Settings.ESP.Friends[plr and plr.Name or""]=="friend"and Settings.Misc.FriendCheck then return end local isM1=eventName=="M1ing"local isInterrupt=interruptMovesSet[eventName]local isBarrage=barrageMovesSet[eventName]if not(isM1 or isInterrupt or isBarrage)then return end local dist=(RootPart.Position-targetHRP.Position).Magnitude local inRange=dist<=(Settings.Autoblock.Range or 9)local movingM1=dist<=Distances.MovingM1 and dashVelocityGuard(targetHRP)local dashPred=Settings.Autoblock.DashPredict and dist<=Distances.FarDash and(isAnimPlaying(ANIM.rsideDash,targetHum)or isAnimPlaying(ANIM.lsideDash,targetHum))if not(inRange or movingM1 or dashPred)then return end if not isFlingTargetValid(Character,localBusySet)then return end if not isFlingTargetValid(targetChar,enemyBusySet)then return end if not inFOV(targetHRP)then return end if isM1 then local last=AB.lastM1[targetChar]if last and tick()-last<0.15 then return end AB.lastM1[targetChar]=tick()end if not autoCounterCast(targetHRP,targetHum,movingM1)then return end if isM1 or isInterrupt then autoblockDistanceState(targetHRP,targetHum,dashPred)elseif isBarrage then autoblockBarrageLoop(targetHRP,targetHum,targetChar,dashPred)end end local DashPred={active={},acc=0}local function dashPredStart(targetChar,hrp,hum)local existing=DashPred.active[targetChar]if existing and tick()-existing.started<0.4 then return end DashPred.active[targetChar]={hrp=hrp,human=hum,started=tick()}end local function dashPredStep()local now=tick()for char,data in pairs(DashPred.active)do if now-data.started>0.65 or not(data.hrp.Parent and data.human.Health>0)then DashPred.active[char]=nil elseif not data.blocked then if not RootPart or not Character then return end if isFlingTargetValid(Character,localBusySet)and isFlingTargetValid(char,enemyBusySet)then local toMe=RootPart.Position-data.hrp.Position toMe=Vector3.new(toMe.X,0,toMe.Z)local vel=data.hrp.AssemblyLinearVelocity vel=Vector3.new(vel.X,0,vel.Z)local sq,dist=vel:Dot(vel),toMe.Magnitude if sq>=25 then local dot=dist>0 and toMe.Unit:Dot(vel)or 0 local tau=math.clamp(toMe:Dot(vel)/sq,0,0.45+getPing(1000))local threat,closing=(toMe-vel*tau).Magnitude,dot>8 if dist<=(Settings.Autoblock.Range or 9)or(closing and threat<=(Settings.Autoblock.Range or 9)+2)then data.blocked=true local blockTime=math.clamp(tau+0.3+getPing(1000),0.3,0.8)task.spawn(function()if autoCounterCast(data.hrp,data.human,false)then beginBlockHold(blockTime,data.hrp,data.human)end end)end end end end end end end connectSignal(RunService.Heartbeat,function(dt)if next(DashPred.active)==nil then return end if not(Settings.Autoblock.Enabled and Settings.Autoblock.DashPredict)then table.clear(DashPred.active);return end DashPred.acc+=dt if DashPred.acc<1/30 then return end DashPred.acc=0 if not(RootPart and Humanoid and Humanoid.Health>0)then return end pcall(dashPredStep)end)local function hookEnemyForAutoblock(enemyModel)if not enemyModel:IsA("Model")or enemyModel==Character or AB.hooked[enemyModel]then return end AB.hooked[enemyModel]=true task.spawn(function()local hum=enemyModel:WaitForChild("Humanoid",10)local animator=hum and hum:WaitForChild("Animator",10)if not animator then return end connectSignal(animator.AnimationPlayed,function(track)if not Settings.Autoblock.Enabled or enemyModel==Character then return end local a=track.Animation local id=a and a.AnimationId:match("%d+")if not id then return end if MOVE_IDS.m1[id]then task.spawn(autoblockReact,enemyModel,"M1ing")elseif MOVE_IDS.dash[id]and Settings.Autoblock.DashPredict then local hrp=enemyModel:FindFirstChild("HumanoidRootPart")if hrp and RootPart and(hrp.Position-RootPart.Position).Magnitude<=45 then dashPredStart(enemyModel,hrp,hum)end end end)end)end local TECH={busy=false,performOnce=false,performOnceId=nil}local function techRagdollWatch(method,duration,targetChar,targetHum,callback)local conn conn=RunService[method]:Connect(function()if not targetChar or targetChar:FindFirstChild("BeingLaunched")or not targetChar:FindFirstChild("Ragdoll")or not targetHum or targetHum.Health<=0 or not Humanoid or Humanoid.Health<=0 then if conn then conn:Disconnect();ActiveConnections[conn]=nil end return end callback()end)ActiveConnections[conn]=true task.wait(duration)if conn then conn:Disconnect();ActiveConnections[conn]=nil end if Humanoid then Humanoid.AutoRotate=true end end local function techTargetPart(part)local which=Settings.AutoTech.TargetPart or"HumanoidRootPart"if not part then return part end local parent=part.Parent if parent and(which=="Head"or which=="Torso")then local target=parent:FindFirstChild(which)if not target and which=="Torso"then target=parent:FindFirstChild("UpperTorso")end if target then return target end end return part end local function techTargetPos(part)local p=techTargetPart(part);return p and p.Position or Vector3.zero end local function techSupa(target,hrp,hum,miss)performDashWithDelay()local offset=hrp.CFrame:PointToObjectSpace(RootPart.Position)techRagdollWatch("Heartbeat",0.3,target,hum,function()local worldPos=hrp.CFrame:PointToWorldSpace(offset)if miss then worldPos=worldPos+hrp.CFrame.RightVector*(math.random()>0.5 and 7 or-7)end local targetPos=techTargetPos(hrp)pcall(function()Character:PivotTo(CFrame.lookAt(worldPos,Vector3.new(targetPos.X,worldPos.Y+1.5,targetPos.Z),Vector3.new(0,1,0)))end)end)end local function techLockOn(target,hrp,hum,miss)performDashWithDelay()techRagdollWatch("Heartbeat",0.7,target,hum,function()local pos=techTargetPos(hrp)if miss then pos=pos+hrp.CFrame.RightVector*(math.random()>0.5 and 8 or-8)end computeLockAngles(nil,pos,true,false,Settings.AutoTech.LockonPrecision)end)end local function techLoopDash(target,hrp,hum,miss)performDashWithDelay()computeLockAngles(90,nil,true);startSmoothRotateCamera(270,0.35,true);task.wait(0.3)local cachedCF techRagdollWatch("Heartbeat",0.4,target,hum,function()local targetPos=techTargetPos(hrp)if miss then local offset=hrp.CFrame.RightVector*(math.random()>0.5 and 7 or-7);computeLockAngles(nil,targetPos+offset,true)elseif cachedCF or isTargetAbove(hrp)then if not cachedCF then if Settings.AutoTech.LoopLooksUp then cachedCF=CFrame.lookAt(RootPart.Position,