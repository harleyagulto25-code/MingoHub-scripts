    addToggle(exploit,"Freeze Hold","Hold key to anchor in place",Settings.Rage.FreezeHold,function(on) Settings.Rage.FreezeHold=on; if not on then State.Freeze.release() end end,function() return Settings.Rage.FreezeHold end)
    addKeybind(exploit,"Freeze Key","",Settings.Rage.FreezeKey,nil,function(k) Settings.Rage.FreezeKey=k end,function() return Settings.Rage.FreezeKey end)
    -- Freeze hold key connections
    connectSignal(UIS.InputBegan, function(input)
        if not Settings.Rage.FreezeHold or UIS:GetFocusedTextBox() then return end
        if input.KeyCode == Settings.Rage.FreezeKey then State.Freeze.hold() end
    end)
    connectSignal(UIS.InputEnded, function(input)
        if State.Freeze.held and input.KeyCode == Settings.Rage.FreezeKey then State.Freeze.release() end
    end)

