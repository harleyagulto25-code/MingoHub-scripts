local function notifySystem(text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "MingoHub", Text = tostring(text), Duration = duration or 4,
        })
    end)
end

local player = Players.LocalPlayer
if not player then
    local waited = 0
    repeat task.wait(0.1); waited += 0.1; player = Players.LocalPlayer
    until player or waited >= 60
end
local PlayerGui = player.PlayerGui or player:WaitForChild("PlayerGui", 10)

local sAutoUnequip = false
pcall(function()
    sAutoUnequip = player:GetAttribute("S_AutoUnequip") or false
    player:GetAttributeChangedSignal("S_AutoUnequip"):Connect(function()
        sAutoUnequip = player:GetAttribute("S_AutoUnequip") or false
    end)
end)

