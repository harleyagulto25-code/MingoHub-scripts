-- ─────────────────────────── Connection management ───────────────
local ActiveConnections   = {}
local PlayerConnections   = {}
local CharacterConnections= {}
local renderBindNames     = {}
local Unloaded = false

local function connectSignal(signal, fn)
    local conn = signal:Connect(function(...)
        if Unloaded then return end
        return fn(...)
    end)
    ActiveConnections[conn] = true
    return conn
end

local function disconnectConn(conn)
    if conn then
        conn:Disconnect()
        ActiveConnections[conn] = nil
    end
end

local function disconnectAll(tbl)
    if not tbl then return end
    for _, conn in ipairs(tbl) do disconnectConn(conn) end
    table.clear(tbl)
end

local function bindRender(name, prio, fn)
    renderBindNames[name] = true
    RunService:BindToRenderStep(name, prio, fn)
end
local function unbindRender(name)
    renderBindNames[name] = nil
    pcall(RunService.UnbindFromRenderStep, RunService, name)
end

-- ─────────────────────────── Player relationship state ───────────
local PlayerFrames = {}  -- name → "Neutral" | "Friend" | "Enemy"

local function isFriend(plr, respectCheck)
    if not plr or not plr.Name then return false end
    if PlayerFrames[plr.Name] == "Friend" then
        if respectCheck then
            return Settings.Misc.FriendCheck and true or false
        end
        return true
    end
    return false
end

local function autoDetectFriend(plr)
    if not PlayerFrames[plr.Name] then
        PlayerFrames[plr.Name] = "Neutral"
    end
    local ok, yes = pcall(function() return plr:IsFriendsWithAsync(player.UserId) end)
    if ok and yes then PlayerFrames[plr.Name] = "Friend" end
end

