    addKeybind(playerTab,"Cycle Friend/Enemy","Click on a player to cycle",nil,function()
        local mouse2 = player:GetMouse(); if not mouse2 then return end
        local target2 = mouse2.Target; if not target2 then return end
        local model2 = target2:FindFirstAncestorOfClass("Model"); if not (model2 and model2:FindFirstChildOfClass("Humanoid")) then return end
        local plr10 = Players:FindFirstChild(model2.Name); if not plr10 then return end
        local cur = PlayerFrames[plr10.Name] or "Neutral"
        if cur=="Friend" then PlayerFrames[plr10.Name]="Neutral"
        elseif cur=="Neutral" then PlayerFrames[plr10.Name]="Enemy"
        else PlayerFrames[plr10.Name]="Friend" end
        applyESPToChar(plr10, model2)
    end,nil,nil)

